# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is gitignored — never commit real credentials.

# Required: Neon pooled connection string (must include ?sslmode=require)
DATABASE_URL=

# Required: secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=

# Optional AI provider for short assistant notes (OpenAI-compatible).
# Leave blank to run without it — the accessibility profile flow is
# fully deterministic and needs no provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# ---------------------------------------------------------------------------
# Trip planning (OpenRouter) — SERVER-ONLY.
# These are read only inside server-only modules (`src/lib/openrouter.ts`).
# Never rename them with a NEXT_PUBLIC_ prefix and never import them into a
# client component: that would expose the key to the browser.
# ---------------------------------------------------------------------------

# Required for trip planning: get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Primary model. The project standard is the free Gemma build:
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free

# Comma-separated backup models, tried in order if the primary is congested
# (OpenRouter's free pool is shared and frequently rate-limited).
OPENROUTER_FALLBACK_MODELS=

# Optional attribution headers OpenRouter shows on your dashboard.
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=Wayfare

# ---------------------------------------------------------------------------
# Nugen Intelligence (Task 2) — SERVER-ONLY.
# Domain-aligned model used for inference by the Digital-Twin advisor.
# Read only inside server-only modules (`src/lib/nugen.ts`). Never prefix with
# NEXT_PUBLIC_ and never import it into a client component.
# Sign up: https://nugen.in/signup?invite=PILLAIUNIV2026
# Docs:    https://docs.nugen.in
# ---------------------------------------------------------------------------

# Required for the Nugen advisor. Copy it from your Nugen dashboard.
NUGEN_API_KEY=

# Base model to align, or the id of your customised/aligned model on Nugen.
NUGEN_MODEL=qwen-v2p5-0p5b-instruct

# Nugen inference base URL (no trailing slash).
NUGEN_BASE_URL=https://api.nugen.in/api/v3
