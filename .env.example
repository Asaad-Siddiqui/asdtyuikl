# Copy this file to .env.local and fill in real values.
#   cp .env.example .env.local
# .env.local is gitignored — never commit real credentials.

# Required: Neon pooled connection string (must include ?sslmode=require)
DATABASE_URL=

# Required: secret used to sign session cookies. Generate one with:
#   openssl rand -hex 32
AUTH_SECRET=

# Optional AI provider (OpenAI-compatible). Leave blank to run without AI —
# the accessibility profile flow is fully deterministic and needs no provider.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
